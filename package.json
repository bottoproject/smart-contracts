{
  "name": "botto-smart-contracts",
  "version": "1.0.0",
  "description": "Smart contracts for BOTTO: The first decentralized autonomous artist",
  "homepage": "https://github.com/bottoproject/smart-contracts",
  "repository": {
    "url": "https://github.com/bottoproject/smart-contracts.git",
    "type": "git"
  },
  "author": "BOTTO",
  "license": "MIT",
  "packageManager": "npm@11.6.1",
  "workspaces": [
    "deployment"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('build/contracts', { recursive: true, force: true })\"",
    "compile": "truffle compile --all",
    "build:reproducible": "npm run clean && npm run compile && node scripts/reproducible-build.js --artifact build/contracts/BottoLiquidityMiningV3.json --output deployments/builds/BottoLiquidityMiningV3.json",
    "test:build": "node --test test/reproducible-build.test.js",
    "test:all": "truffle test --compile-none",
    "test:v3": "truffle test test/BottoLiquidityMiningV3.test.js --compile-none",
    "deploy:compile": "npm run compile --workspace=@botto/mainnet-deployment",
    "deploy:inspect": "npm run inspect --workspace=@botto/mainnet-deployment",
    "deploy:prepare": "npm run deploy-implementation --workspace=@botto/mainnet-deployment",
    "deploy:propose": "npm run propose --workspace=@botto/mainnet-deployment",
    "deploy:verify": "npm run verify --workspace=@botto/mainnet-deployment",
    "deploy:recover-proposal": "npm run recover-proposal --workspace=@botto/mainnet-deployment",
    "test:deploy:unit": "npm run test:unit --workspace=@botto/mainnet-deployment",
    "test:deploy:fork": "npm run test:fork --workspace=@botto/mainnet-deployment"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "^3.4.0",
    "@openzeppelin/contracts-upgradeable": "^3.4.0",
    "@openzeppelin/test-helpers": "^0.5.10",
    "@openzeppelin/truffle-upgrades": "^1.5.0",
    "@truffle/contract": "^4.3.7",
    "@truffle/hdwallet-provider": "^1.2.2",
    "@uniswap/lib": "^4.0.1-alpha",
    "@uniswap/sdk": "^3.0.3",
    "@uniswap/v2-core": "^1.0.1",
    "@uniswap/v2-periphery": "^1.1.0-beta.0",
    "dotenv": "^8.2.0",
    "eslint": "^7.20.0",
    "ethers": "^5.0.31",
    "merkle-tree-solidity": "^1.0.8",
    "moment": "^2.29.1",
    "prettier": "2.4.1",
    "solc": "0.7.6",
    "truffle": "5.11.5",
    "truffle-plugin-verify": "^0.5.15"
  },
  "engines": {
    "node": "24.10.0",
    "npm": "11.6.1"
  },
  "dependencies": {}
}
